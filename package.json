{
	"name": "mdpower",
	"version": "1.0.5",
	"description": "MDPOWER - High-performance native Markdown reader & power viewer",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "vite build && electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"fix-icons": "powershell -ExecutionPolicy Bypass -File scripts/fix-icons.ps1",
		"register": "powershell -ExecutionPolicy Bypass -File scripts/register-dev.ps1",
		"build:prod": "vite build && electrobun build --env=stable",
		"build:prod:win": "vite build && electrobun build --env=stable && powershell -ExecutionPolicy Bypass -File scripts/fix-icons.ps1",
		"package:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
	},
	"dependencies": {
		"electrobun": "1.18.1",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.18.0",
		"mermaid": "^11.15.0",
		"motion": "^13.2.0",
		"prismjs": "^1.30.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
